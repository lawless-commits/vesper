# Copy to .env.local and fill in. Never commit .env.local.

# Required. Postgres connection string used by the app and by drizzle-kit.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional. When set, POST /api/automation/run only accepts requests that come
# from the app's own pages (same-origin) or carry this value in an
# `x-autopilot-token` header. Use it for cron jobs.
AUTOPILOT_TOKEN=

# Optional. API key for your model server. When set it overrides any key saved
# on the Runtime page, and nothing needs to be stored in the database.
LLM_API_KEY=

# Optional. When set, every page and API route (except /api/health) requires
# HTTP Basic auth with this password; any username works. Leave empty for
# normal local use. Vesper is single-user and not built for the open internet.
VESPER_PASSWORD=
